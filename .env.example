# Copy this file to .env (or export these vars in your shell) before running ms_pipeline.

# VS MCP endpoint
MOLCLAW_VS_MCP_SERVER_NAME=molclaw-vs
MOLCLAW_VS_MCP_URL=
MOLCLAW_VS_MCP_AUTH_HEADER=Authorization
MOLCLAW_VS_MCP_AUTH=

# AC/PF MCP endpoint
MOLCLAW_SCP_MCP_SERVER_NAME=molclaw-scp
MOLCLAW_SCP_MCP_URL=
MOLCLAW_SCP_MCP_AUTH_HEADER=SCP-HUB-API-KEY
MOLCLAW_SCP_MCP_AUTH=

# Optional default provider for cc-switch
CC_SWITCH_PROVIDER=qwen-397b
